<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Monitoring.App</RootNamespace>
    <AssemblyName>MonitoringApp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Monitoring.Core/Monitoring.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="user_themes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
