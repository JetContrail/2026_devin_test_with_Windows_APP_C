<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LongRun</RootNamespace>
    <!-- soak/soak-tools run long-lived code; keep analyzers off for speed -->
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Monitoring.Core/Monitoring.Core.csproj" />
  </ItemGroup>
</Project>
